# local | preprod | prod — pilote corpus, e-mails, Stripe (spec 06 §7)
ENV=local
# Neon (branche dev/preprod/main) ou Postgres Docker local
DATABASE_URL=postgresql://lune:lune@localhost:5432/lune
# Fichiers Swiss Ephemeris sepl_18.se1, semo_18.se1
EPHE_PATH=data/ephe
# Adresse publique (liens des e-mails, Open Graph)
BASE_URL=https://malunenoire.fr
# Identifiant de version (git) : cache des fichiers statiques, engine_version
GIT_SHA=dev
# Sel des hachages : feedback anonyme, limites de débit, signature des désinscriptions
FEEDBACK_SALT=
# Secret partagé avec Cloud Scheduler (en-tête X-Cron-Secret)
CRON_SECRET=
# E-mails : clé Resend ; en préproduction tout part vers EMAIL_REDIRECT ; alertes vers ADMIN_EMAIL
RESEND_API_KEY=
EMAIL_REDIRECT=
ADMIN_EMAIL=
EMAIL_PLAFOND=90
# Phase 1.5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
